# Copy to .env (never commit it). Every setting below is read by src/sql_analyst/config.py.
# With nothing set, the demo uses the offline MockSQLWriter and the defaults shown here.

# Model: mock (default, offline) | anthropic | openai
LLM_PROVIDER=mock
# Model id for the real provider (defaults: claude-opus-5-5 / gpt-4.1-mini)
# LLM_MODEL=

# Provider keys, read by the official SDKs (only needed when LLM_PROVIDER is not mock)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Where the demo database is built. WARNING: this file is deleted and rebuilt from SQL_SEED on every run.
# Default: <system temp>/sql_analyst_shop.db
# SQL_DB_PATH=
SQL_SEED=examples/shop.sql
# Demo questions, one per line (used when no question is given on the command line)
SQL_QUESTIONS=examples/questions.txt

# Agent limits
# Draft + repair attempts per question
SQL_MAX_ATTEMPTS=3
# LIMIT the guard adds or caps
SQL_MAX_ROWS=200
# Wall-clock budget per query, enforced by a SQLite progress handler
SQL_TIMEOUT_MS=2000
