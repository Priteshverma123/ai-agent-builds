# Copy to .env (never commit it). Every setting is optional; defaults run fully offline.

# --- Model -------------------------------------------------------------------
# mock (default, replays examples/debates.json) | anthropic | openai
LLM_PROVIDER=mock
# Leave empty for the provider default (anthropic: claude-opus-5-5, openai: gpt-4.1-mini)
LLM_MODEL=
# Only needed for the matching provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Debate ------------------------------------------------------------------
# Hard cap on rounds (the debate also stops early once no stance changes); CLI --max-rounds overrides
DEBATE_MAX_ROUNDS=4
# Share of confidence-weighted votes the leading stance needs to be called consensus (0-1)
CONSENSUS_THRESHOLD=0.66
# Script the MockDebateLLM replays and the demo's questions (empty = examples/debates.json)
DEBATE_SCRIPT=
