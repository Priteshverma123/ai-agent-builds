# Every setting the code reads (see src/eval_optimizer/config.py). All have safe defaults:
# with nothing set, the project runs fully offline on the deterministic MockLLM.
# Export these in your shell or copy to .env for your tooling. Never commit a real .env.

# --- LLM provider (used as both writer and judge) ----------------------------
# mock (default, offline) | anthropic | openai
LLM_PROVIDER=mock
# Model override; empty = provider default (claude-opus-5-5 / gpt-4.1-mini)
LLM_MODEL=
# Read directly by the provider SDKs, only when LLM_PROVIDER is anthropic / openai
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# --- Optimizer loop -----------------------------------------------------------
# Stop when the rubric total (0-100) reaches this
OPT_TARGET=90
# Hard budget: maximum number of drafts
OPT_MAX_ITERATIONS=6
# Plateau: stop after OPT_PATIENCE rounds that gain less than OPT_MIN_DELTA points
OPT_PATIENCE=2
OPT_MIN_DELTA=1.0
# How many of the most costly issues the writer gets per revision
OPT_FIXES_PER_ROUND=2
# Brief JSON (default: examples/brief.json next to src/)
# OPT_BRIEF_FILE=./examples/brief.json
