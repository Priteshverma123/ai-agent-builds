# Copy to .env (never commit it). Every setting below is read by src/tracekit/config.py.
# With nothing set, the demo uses the offline MockLLM on a simulated clock and the defaults shown here.

# Model: mock (default, offline) | anthropic | openai
LLM_PROVIDER=mock
# Model id for the real provider (defaults: claude-opus-5-5 / gpt-4o-mini); also the PRICES lookup key
# LLM_MODEL=

# Provider keys, read by the official SDKs (only needed when LLM_PROVIDER is not mock).
# They never reach a trace: spans.redact() masks secret-looking keys and values.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Where trace.jsonl and trace.html are written (CLI --out overrides)
TRACE_OUT_DIR=out
# Questions to run, one per line (CLI --questions overrides)
TRACE_QUESTIONS=examples/questions.txt
# true = measure wall-clock time instead of the deterministic simulated clock (CLI --real-clock)
TRACE_REAL_CLOCK=false
# Agent steps per run, and retries after a failing tool call
AGENT_MAX_STEPS=6
AGENT_TOOL_RETRIES=1
