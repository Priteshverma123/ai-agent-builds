# Every setting the code reads (see src/mcp_client_agent/config.py). All have safe defaults:
# with nothing set, the project runs fully offline on the deterministic MockLLM.
# Export these in your shell or copy to .env for your tooling. Never commit a real .env.

# --- LLM provider -------------------------------------------------------------
# mock (default, offline) | anthropic | openai
LLM_PROVIDER=mock
# Model override; empty = provider default (claude-opus-5-5 / gpt-4.1-mini)
LLM_MODEL=
# Read directly by the provider SDKs, only when LLM_PROVIDER is anthropic / openai
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# --- MCP ----------------------------------------------------------------------
# servers.json listing the MCP servers to launch (relative .py args resolve next to the file)
# MCP_SERVERS_CONFIG=./examples/servers.json
# Seconds to wait for any single MCP reply before cancelling it
MCP_TIMEOUT=10

# --- Agent --------------------------------------------------------------------
# Tool-calling steps allowed per task before the loop stops
AGENT_MAX_STEPS=6
# Demo tasks, one per line
# AGENT_TASKS_FILE=./examples/tasks.txt
