# Copy to .env (never commit it). Every variable the gateway reads; all optional, defaults run offline.
# Comments sit on their own lines so the file also works with `docker run --env-file`.

# --- Providers: two named upstreams ("alpha", "beta") so fallback has somewhere to go ---
# mock | anthropic | openai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Map gateway model names to real model ids (only used with a real provider).
# MODEL_MAP=alpha-fast=claude-haiku-4-5,alpha-pro=claude-sonnet-4-5,beta-fast=claude-haiku-4-5,beta-pro=claude-sonnet-4-5
PROVIDER_TIMEOUT_S=30

# --- Tenants, audit ---
# Tenants, plans and hashed API keys. Default: ./examples/tenants.json
# GATEWAY_TENANTS=./examples/tenants.json
# Append the hash-chained audit log to this JSONL file. Empty = in memory only.
# GATEWAY_AUDIT_FILE=./out/audit.jsonl

# --- Cache and circuit breaker ---
CACHE_TTL_S=300
CACHE_MAX_ENTRIES=1000
# Consecutive provider failures that open a circuit, and how long it stays open (seconds).
BREAKER_THRESHOLD=3
BREAKER_COOLDOWN_S=30

# --- HTTP server (`gateway serve`, `python -m gateway.serve`) ---
HOST=127.0.0.1
PORT=8000
