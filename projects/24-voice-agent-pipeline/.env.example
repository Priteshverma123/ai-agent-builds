# Copy to .env (never commit it). Every setting is optional; defaults run fully offline.

# --- Model -------------------------------------------------------------------
# mock (default: virtual clock, instant & deterministic) | anthropic | openai (real clock)
LLM_PROVIDER=mock
# Leave empty for the provider default (anthropic: claude-opus-5-5, openai: gpt-4.1-mini)
LLM_MODEL=
# Only needed for the matching provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Pipeline ----------------------------------------------------------------
# streaming (phrases go to TTS while the LLM writes) | batch (wait for the full reply); CLI --mode overrides
VOICE_MODE=streaming
# Say "One moment." if no token has arrived after this many ms; "off" disables (CLI --no-filler)
FILLER_AFTER_MS=450
# Voice-to-voice latency target per turn, in ms
LATENCY_BUDGET_MS=1000
# The mock caller's utterances (empty = examples/conversation.json)
CONVERSATION_SCRIPT=
