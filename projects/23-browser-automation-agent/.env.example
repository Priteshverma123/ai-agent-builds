# Copy to .env (never commit it). Every setting is optional; defaults run fully offline.

# --- Model -------------------------------------------------------------------
# mock (default, offline & deterministic) | anthropic | openai
LLM_PROVIDER=mock
# Leave empty for the provider default (anthropic: claude-opus-5-5, openai: gpt-4.1-mini)
LLM_MODEL=
# Only needed for the matching provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Agent -------------------------------------------------------------------
# Observe -> act iterations before the agent stops (CLI --max-steps overrides)
AGENT_MAX_STEPS=25
# Folder with catalog.json + page templates for the simulated shop (empty = examples/site)
SHOP_SITE_DIR=
