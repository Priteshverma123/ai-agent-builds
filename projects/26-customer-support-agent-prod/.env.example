# Copy to .env (never commit .env). Everything is optional; defaults run fully offline.
# Comments sit on their own lines so the file also works with `docker run --env-file`.

# --- LLM ---
# mock | anthropic | openai
LLM_PROVIDER=mock
# anthropic default: claude-opus-5-5; openai: required
LLM_MODEL=
# Read by the provider SDK when LLM_PROVIDER selects it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Business policy (enforced in code, not by the model) ---
REFUND_WINDOW_DAYS=30
REFUND_AUTO_APPROVE_LIMIT=200
# Think -> tool -> observe iterations per turn before the agent escalates.
MAX_AGENT_STEPS=6

# --- Service ---
# If set, clients must send X-API-Key on every endpoint except /health.
SUPPORT_API_KEY=
# Pins the clock so the sample orders are inside the refund window. Empty = real date.
SUPPORT_TODAY=2026-10-20
# Folder with orders.json, evals.json and policies/. Default: ./examples
# SUPPORT_DATA_DIR=./examples
# How many traces /traces keeps in memory (oldest evicted first).
TRACE_CAPACITY=500
LOG_LEVEL=INFO
