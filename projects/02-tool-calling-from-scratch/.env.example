# Copy to .env (never commit it) or export these in your shell.
# Every setting the code reads is listed here (see src/toolcall/config.py); all defaults work offline.
# Leave a value empty to use its default.

# Which model backend to use: mock (default, offline) | anthropic | openai
LLM_PROVIDER=mock
# Read by the official SDKs when LLM_PROVIDER is anthropic / openai.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override. Empty = provider default (claude-opus-5-5 / gpt-4.1-mini).
LLM_MODEL=

# Model calls per question before the tool loop gives up.
MAX_TOOL_ROUNDS=5
