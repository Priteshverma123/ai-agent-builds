# Every setting the code reads (see src/router_agent/config.py). All have safe defaults:
# with nothing set, the project runs fully offline on the deterministic MockRouterLLM.
# Export these in your shell or copy to .env for your tooling. Never commit a real .env.

# --- LLM provider -------------------------------------------------------------
# mock (default, offline) | anthropic | openai
LLM_PROVIDER=mock
# Model override; empty = provider default (claude-opus-5-5 / gpt-4.1-mini)
LLM_MODEL=
# Read directly by the provider SDKs, only when LLM_PROVIDER is anthropic / openai
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# --- Router -------------------------------------------------------------------
# Minimum classifier confidence to send a message to a specialist (else: fallback)
ROUTER_THRESHOLD=0.6
# Intent descriptions + few-shot examples, and the labelled eval set
# (defaults: examples/intents.json and examples/labelled.jsonl next to src/)
# ROUTER_INTENTS_FILE=./examples/intents.json
# ROUTER_LABELLED_FILE=./examples/labelled.jsonl
