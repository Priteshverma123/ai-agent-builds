# Copy to .env (never commit it). Every setting below is read by src/guardrails/config.py.
# With nothing set, the demo uses the offline GullibleMockLLM and the defaults shown here.

# Model: mock (default, offline) | anthropic | openai
LLM_PROVIDER=mock
# Model id for the real provider (defaults: claude-opus-5-5 / gpt-4o-mini)
# LLM_MODEL=

# Provider keys, read by the official SDKs (only needed when LLM_PROVIDER is not mock)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Detector score (0..1) at which text counts as an injection and is quarantined
GUARD_THRESHOLD=0.5
# Model turns before the agent stops with "step limit reached"
AGENT_MAX_STEPS=6
# Folder with the fake web, notes.txt and redteam.jsonl (default: ./examples)
# EXAMPLES_DIR=./examples
