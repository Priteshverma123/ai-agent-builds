# Copy to .env (never commit it) or export these in your shell.
# Every setting the code reads is listed here (see src/research_agent/config.py); all defaults work offline.
# Leave a value empty to use its default.

# Which model backend to use: mock (default, offline) | anthropic | openai
LLM_PROVIDER=mock
# Read by the official SDKs when LLM_PROVIDER is anthropic / openai.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override. Empty = provider default (claude-opus-5-5 / gpt-4.1-mini).
LLM_MODEL=

# Folder of .txt pages that stands in for the web. Empty = examples/web (overridden by --web-dir).
RESEARCH_WEB_DIR=

# Search results considered for each planned query.
RESEARCH_RESULTS_PER_QUERY=2

# Page fetches allowed per question: the agent's budget (overridden by --max-fetches).
RESEARCH_MAX_FETCHES=5
