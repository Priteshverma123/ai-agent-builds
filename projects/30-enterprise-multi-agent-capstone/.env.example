# Copy to .env (never commit it). Every variable the assistant reads; all optional, defaults run offline.
# Comments sit on their own lines so the file also works with `docker run --env-file` and docker compose.

# --- LLM: planning + answer writing; any provider error falls back to the MockLLM ---
# mock | anthropic | openai
LLM_PROVIDER=mock
# Empty = provider default (anthropic: claude-sonnet-4-5, openai: gpt-4o-mini).
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Knowledge, evals, traces ---
# Handbook folder the RAG index is built from. Default: ./examples/docs
# DOCS_DIR=./examples/docs
# Eval cases used by `python run_evals.py` and the demo. Default: ./examples/evals.json
# EVALS_FILE=./examples/evals.json
# JSONL file the HTTP server appends every trace to (relative to the working directory).
TRACE_FILE=out/traces.jsonl

# --- Orchestrator ---
# Maximum plan steps executed per request.
ORCHESTRATOR_MAX_STEPS=6

# --- HTTP server (`capstone serve`) ---
HOST=127.0.0.1
PORT=8000
