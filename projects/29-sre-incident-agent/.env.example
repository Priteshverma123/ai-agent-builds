# Copy to .env (never commit it). Every variable the agent reads; all optional, defaults run offline.
# Comments sit on their own lines so the file also works with `docker run --env-file`.

# --- LLM: a real model only *proposes* actions; any error falls back to the MockLLM policy ---
# mock | anthropic | openai
LLM_PROVIDER=mock
# Empty = provider default (anthropic: claude-sonnet-4-5, openai: gpt-4o-mini).
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Incident data and output ---
# Folder with alert.json, runbooks.json and incident/ (metrics, logs, deploys, services). Default: ./examples
# SRE_EXAMPLES_DIR=./examples
# Where postmortem.md is written. Default: ./out
# SRE_OUT_DIR=./out
# Think -> act -> observe iterations before the agent stops with status=step_limit.
SRE_MAX_STEPS=15
