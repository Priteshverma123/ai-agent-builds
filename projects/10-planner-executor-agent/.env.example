# Every setting the code reads (see src/planner_executor/config.py). All have safe defaults:
# with nothing set, the project runs fully offline on the deterministic MockPlannerLLM.
# Export these in your shell or copy to .env for your tooling. Never commit a real .env.

# --- LLM provider -------------------------------------------------------------
# mock (default, offline) | anthropic | openai
LLM_PROVIDER=mock
# Model override; empty = provider default (claude-opus-5-5 / gpt-4.1-mini)
LLM_MODEL=
# Read directly by the provider SDKs, only when LLM_PROVIDER is anthropic / openai
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# --- Agent --------------------------------------------------------------------
# How many times the planner may repair a failed plan before the run is marked failed
AGENT_MAX_REPLANS=2
# File holding the demo goal (default: examples/goal.txt next to src/)
# AGENT_GOAL_FILE=./examples/goal.txt
