# Copy to .env (never commit it). Every setting is optional; defaults run fully offline.

# --- Models (planner + extractor) ---------------------------------------------
# mock (default, offline & deterministic) | anthropic | openai
LLM_PROVIDER=mock
# Leave empty for the provider default (anthropic: claude-opus-5-5, openai: gpt-4.1-mini)
LLM_MODEL=
# Only needed for the matching provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Swarm -------------------------------------------------------------------
# Max fetches in flight across all workers (CLI --concurrency overrides)
SWARM_CONCURRENCY=3
# Per-attempt fetch timeout in seconds (the clock starts after a concurrency slot is free)
FETCH_TIMEOUT_S=0.3
# Extra attempts for transient failures (503s, timeouts), with exponential backoff
FETCH_RETRIES=1
# How many top search results each worker fetches
DOCS_PER_WORKER=3
# Folder of markdown documents acting as the local "web" (empty = examples/corpus)
CORPUS_DIR=
