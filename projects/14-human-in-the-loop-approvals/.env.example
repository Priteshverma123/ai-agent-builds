# Copy to .env (never commit it). Every setting below is read by src/hitl/config.py.
# With nothing set, the demo uses the offline PlannerMockLLM and the defaults shown here.

# Model: mock (default, offline) | anthropic | openai
LLM_PROVIDER=mock
# Model id for the real provider (defaults: claude-opus-5-5 / gpt-4o-mini)
# LLM_MODEL=

# Provider keys, read by the official SDKs (only needed when LLM_PROVIDER is not mock)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Where paused runs, the fake back office and the audit log are stored (--state overrides it)
HITL_STATE_DIR=.hitl_state
# Model turns before a run fails with "step limit reached"
AGENT_MAX_STEPS=10

# Risk scoring (risk.py RiskPolicy)
# Comma-separated domains treated as internal email recipients
RISK_COMPANY_DOMAINS=acme.example
# Refunds above this add +20 risk
RISK_LARGE_AMOUNT=100
# Refunds above this add +35 risk instead
RISK_VERY_LARGE_AMOUNT=1000
