# Copy to .env (never commit it) or export these in your shell.
# Every setting the code reads is listed here (see src/rag/config.py); all defaults work offline.
# Leave a value empty to use its default.

# Which model backend to use: mock (default, offline) | anthropic | openai
LLM_PROVIDER=mock
# Read by the official SDKs when LLM_PROVIDER is anthropic / openai.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override. Empty = provider default (claude-opus-5-5 / gpt-4.1-mini).
LLM_MODEL=

# Folder of .md files to index. Empty = examples/docs (overridden by --docs).
RAG_DOCS_DIR=

# Chunks retrieved per question (overridden by -k).
RAG_TOP_K=3

# Maximum words per chunk when indexing.
RAG_CHUNK_WORDS=40

# Cosine-similarity floor: chunks below it are ignored; if none pass, the LLM is skipped.
RAG_MIN_SCORE=0.1
