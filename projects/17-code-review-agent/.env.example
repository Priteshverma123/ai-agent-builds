# Copy to .env (never commit it). Every setting below is read by src/reviewer/config.py.
# With nothing set, the demo uses the offline MockReviewerLLM and reviews examples/change.diff.
# Command-line flags (--diff, --base, --format, --fail-on, --static-only) override these.

# Model: mock (default, offline) | anthropic | openai
LLM_PROVIDER=mock
# Model id for the real provider (defaults: claude-opus-5-5 / gpt-4o-mini)
# LLM_MODEL=

# Provider keys, read by the official SDKs (only needed when LLM_PROVIDER is not mock)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Unified diff to review (a file path, or - for stdin) and the checkout it applies to
REVIEW_DIFF=examples/change.diff
REVIEW_BASE=examples/base
# Output: text | markdown | json
REVIEW_FORMAT=text
# CI gate: exit 1 if any finding is at or above this severity (low | medium | high | critical); empty = never
REVIEW_FAIL_ON=
# true = skip the LLM pass and report static findings only
REVIEW_STATIC_ONLY=false
