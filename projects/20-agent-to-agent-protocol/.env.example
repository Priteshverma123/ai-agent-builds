# Copy to .env (never commit it). Every setting is optional; defaults run fully offline.

# --- Planner model -------------------------------------------------------------
# mock (default, offline & deterministic) | anthropic | openai
LLM_PROVIDER=mock
# Leave empty for the provider default (anthropic: claude-opus-5-5, openai: gpt-4.1-mini)
LLM_MODEL=
# Only needed for the matching provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Agents --------------------------------------------------------------------
# Simulated work time of the slow Packing Weather agent (makes polling visible)
WEATHER_WORK_SECONDS=0.4
# How many input-required questions the planner answers per task before giving up
PLANNER_MAX_FOLLOWUPS=2

# --- `--serve` mode (one agent on a fixed port) ---------------------------------
A2A_HOST=127.0.0.1
A2A_PORT=8001
