# Copy to .env (never commit it). Every variable the code reads is listed here; all are optional.
# Comments sit on their own lines so the file also works with `docker run --env-file`.

# --- LLM: the offline MockLLM is the default and is what the tests use ---
# mock | anthropic | openai
LLM_PROVIDER=mock
# Overrides the provider default (anthropic: claude-opus-5-5, openai: gpt-4.1-mini).
# LLM_MODEL=claude-opus-5-5
# Read by the provider SDK when LLM_PROVIDER selects it.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Durable engine ---
# Where journal.db + world.db live. Default: <system temp>/durable_agent_demo
# DURABLE_DATA_DIR=
# Seconds a worker's lease lasts without a heartbeat.
DURABLE_LEASE_S=1.0
