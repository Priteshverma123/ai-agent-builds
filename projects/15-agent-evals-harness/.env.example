# Copy to .env (never commit it). Every setting below is read by src/evalkit/config.py.
# With nothing set, the demo uses the offline mock support bot + mock judge and the defaults shown here.

# Agent under test: mock (default, offline) | anthropic | openai
LLM_PROVIDER=mock
# Model id for the real provider (defaults: claude-opus-5-5 / gpt-4o-mini)
# LLM_MODEL=

# Provider keys, read by the official SDKs (only needed when LLM_PROVIDER is not mock)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Suite and baseline (CLI --suite / --baseline override these)
EVAL_SUITE=examples/support_suite.json
EVAL_BASELINE=examples/baseline.json
# Where results-*.json and report-*.md are written (CLI --out overrides)
EVAL_OUT_DIR=out
# Repeat each case N times to expose flaky behaviour (CLI --trials overrides)
EVAL_TRIALS=1
# Agent turns per case before "[no answer: step limit]"
AGENT_MAX_STEPS=4
