# Every setting the code reads (see src/memory_agent/config.py). All have safe defaults:
# with nothing set, the project runs fully offline on the deterministic MockMemoryLLM.
# Export these in your shell or copy to .env for your tooling. Never commit a real .env.

# --- LLM provider -------------------------------------------------------------
# mock (default, offline) | anthropic | openai
LLM_PROVIDER=mock
# Model override; empty = provider default (claude-opus-5-5 / gpt-4.1-mini)
LLM_MODEL=
# Read directly by the provider SDKs, only when LLM_PROVIDER is anthropic / openai
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# --- Memory -------------------------------------------------------------------
# Short-term buffer budget in (estimated) tokens before old turns are summarised
MEMORY_BUFFER_TOKENS=60
# How many long-term memories are recalled into each prompt
MEMORY_RECALL_K=4
# SQLite file for long-term memory; empty = fresh temporary file per run
MEMORY_DB=

# --- Paths --------------------------------------------------------------------
# Folder holding sessions.json (default: ./examples next to src/)
# EXAMPLES_DIR=./examples
