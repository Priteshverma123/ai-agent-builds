# Every setting the code reads (see src/mcp_from_scratch/config.py). All have safe defaults.
# The server is stdlib-only, offline, and needs no API key: the LLM lives in the MCP host
# (Claude Desktop, Claude Code, or project 09), not in this server.

# Paths default to ./examples next to src/ (independent of the working directory).
# Seed notes loaded when the server starts (edits stay in memory for the session)
# MCP_NOTES_FILE=./examples/notes.json
# Markdown file served as the docs://handbook resource
# MCP_HANDBOOK_FILE=./examples/handbook.md
