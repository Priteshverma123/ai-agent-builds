# Copy to .env (never commit .env). Defaults run fully offline with the MockLLM.
# Comments sit on their own lines so the file also works with `docker run --env-file`.

# --- LLM extractor ---
# mock | anthropic | openai  (the --provider flag overrides this)
LLM_PROVIDER=mock
# anthropic default: claude-opus-5-5; openai: required
LLM_MODEL=
# Read by the provider SDK when LLM_PROVIDER selects it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Default paths (the --inbox/--client/--master/--golden/--out flags override these) ---
# INTAKE_INBOX=./examples/inbox
# INTAKE_CLIENT=./examples/clients/northwind.json
# INTAKE_MASTER=./examples/master
# INTAKE_GOLDEN=./examples/golden/expected.json
# INTAKE_OUT_DIR=./out
