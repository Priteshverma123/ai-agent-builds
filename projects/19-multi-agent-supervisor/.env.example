# Copy to .env (never commit it). Every setting is optional; defaults run fully offline.

# --- Model -------------------------------------------------------------------
# mock (default, offline & deterministic) | anthropic | openai
LLM_PROVIDER=mock
# Leave empty for the provider default (anthropic: claude-opus-5-5, openai: gpt-4.1-mini)
LLM_MODEL=
# Only needed for the matching provider
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Supervisor budgets --------------------------------------------------------
# Max supervisor turns before the run stops as "incomplete" (CLI --max-steps overrides)
SUPERVISOR_MAX_STEPS=8
# Max times the coder may be called (stops coder/reviewer ping-pong)
SUPERVISOR_MAX_CODER_VISITS=3

# --- Workers -----------------------------------------------------------------
# Seconds the reviewer lets candidate code run before failing the review
REVIEW_TIMEOUT_S=2.0
# Folder of markdown docs the researcher searches (empty = examples/kb)
KB_DIR=
